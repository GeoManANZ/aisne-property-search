# Copy to .env and fill in.  .env is gitignored — NEVER commit it.

# 2Captcha API key (https://2captcha.com) — legacy/optional, the SeLoger
# BFF path does NOT solve CAPTCHAs.
TWOCAPTCHA_API_KEY=

# Webshare residential proxy credentials (REQUIRED — config.py fails loudly
# if missing).  Get them from the Webshare dashboard / download list.
# Username base is typically "ualfuslo"; French sticky sessions use the
# "ualfuslo-fr-N" prefix (see WEBSHARE_FR_STICKY_PREFIX in config.py).
WEBSHARE_USERNAME=
WEBSHARE_PASSWORD=

# Optional overrides
# HERMES_SCAN_DIR=/path/to/scans
# WARP_HOST=cloudflare-warp
# WARP_PORT=1080
# DEFAULT_TIMEOUT_S=20
# CAPTCHA_MAX_SPEND_USD=5.0
