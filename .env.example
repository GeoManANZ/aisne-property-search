# Copy to .env and fill in.  .env is gitignored — NEVER commit it.

# 2Captcha API key (https://2captcha.com)
TWOCAPTCHA_API_KEY=

# Webshare residential proxy credentials (if not provided, config.py falls
# back to the values in the nz-mortgage-saas proxy_config.py)
WEBSHARE_USERNAME=
WEBSHARE_PASSWORD=

# Optional overrides
# HERMES_SCAN_DIR=/path/to/scans
# WARP_HOST=cloudflare-warp
# WARP_PORT=1080
# DEFAULT_TIMEOUT_S=20
# CAPTCHA_MAX_SPEND_USD=5.0
